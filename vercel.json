{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/data/fees/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/data/fees/releases/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
